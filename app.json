{
  "expo": {
    "name": "SCARS",
    "slug": "debttracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A4FD6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.debttracker.app",
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.debttracker.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A4FD6"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-local-authentication"
    ],
    "extra": {
      "eas": {
        "projectId": "04a352d9-4932-4dd2-bdb2-70988adf6c6d"
      }
    }
  }
}
